{
  "documentStandard" : "FORGESPHERE_MCP_DEFINITION",
  "documentVersion" : "1.0",
  "name" : "github-repo-insights-mcp-mcp",
  "displayName" : "Git Repo Insights",
  "description" : "DeepWiki-style repository insights -- give an owner/repo and get its description, primary languages, and top contributors, backed by the real public GitHub REST API (no API key required for public repos, subject to GitHub's standard unauthenticated rate limit).",
  "version" : "1.0.0",
  "targetProtocolVersion" : "2026-07-28",
  "transport" : "STREAMABLE_HTTP",
  "capabilities" : {
    "tools" : { },
    "resources" : { },
    "prompts" : { }
  },
  "security" : {
    "type" : "NONE"
  },
  "tools" : [ {
    "name" : "get_repository_details",
    "description" : "Get a repository's core details",
    "inputSchema" : {
      "type" : "object",
      "properties" : {
        "owner" : {
          "type" : "string",
          "description" : "The GitHub organization or user that owns the repository, e.g. anthropics."
        },
        "repo" : {
          "type" : "string",
          "description" : "The repository name, e.g. anthropic-sdk-python."
        }
      },
      "required" : [ "owner", "repo" ]
    },
    "bindingType" : "HTTP",
    "http" : {
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}",
      "pathParams" : [ "owner", "repo" ],
      "query" : [ ],
      "headers" : [ ],
      "bodyArg" : ""
    },
    "binding" : {
      "type" : "HTTP",
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}",
      "pathParameters" : [ "owner", "repo" ],
      "queryParameters" : [ ],
      "headers" : [ ],
      "bodyArgument" : ""
    }
  }, {
    "name" : "get_repository_languages",
    "description" : "Get a repository's language breakdown",
    "inputSchema" : {
      "type" : "object",
      "properties" : {
        "owner" : {
          "type" : "string"
        },
        "repo" : {
          "type" : "string"
        }
      },
      "required" : [ "owner", "repo" ]
    },
    "bindingType" : "HTTP",
    "http" : {
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}/languages",
      "pathParams" : [ "owner", "repo" ],
      "query" : [ ],
      "headers" : [ ],
      "bodyArg" : ""
    },
    "binding" : {
      "type" : "HTTP",
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}/languages",
      "pathParameters" : [ "owner", "repo" ],
      "queryParameters" : [ ],
      "headers" : [ ],
      "bodyArgument" : ""
    }
  }, {
    "name" : "get_repository_contributors",
    "description" : "Get a repository's top contributors",
    "inputSchema" : {
      "type" : "object",
      "properties" : {
        "owner" : {
          "type" : "string"
        },
        "repo" : {
          "type" : "string"
        },
        "per_page" : {
          "type" : "integer",
          "default" : 10,
          "minimum" : 1,
          "maximum" : 100,
          "description" : "Number of contributors to return."
        }
      },
      "required" : [ "owner", "repo" ]
    },
    "bindingType" : "HTTP",
    "http" : {
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}/contributors",
      "pathParams" : [ "owner", "repo" ],
      "query" : [ {
        "arg" : "per_page",
        "name" : "per_page"
      } ],
      "headers" : [ ],
      "bodyArg" : ""
    },
    "binding" : {
      "type" : "HTTP",
      "method" : "GET",
      "path" : "/repos/{owner}/{repo}/contributors",
      "pathParameters" : [ "owner", "repo" ],
      "queryParameters" : [ {
        "argument" : "per_page",
        "name" : "per_page"
      } ],
      "headers" : [ ],
      "bodyArgument" : ""
    }
  } ],
  "resources" : [ {
    "uri" : "docs://usage-guide",
    "name" : "usage_guide",
    "description" : "Guidance on using this GitHub insights MCP server",
    "mimeType" : "text/plain",
    "text" : "This MCP server exposes GitHub repository insights. Call get_repository_details for a repo's description and stats, get_repository_languages for its language breakdown, and get_repository_contributors for its top contributors. Provide owner and repo for each call."
  } ],
  "prompts" : [ {
    "name" : "summarize_repository",
    "description" : "",
    "template" : "Summarize the GitHub repository {{owner}}/{{repo}}. Use get_repository_details for its\ndescription and stats, get_repository_languages for its tech stack, and\nget_repository_contributors for who maintains it. Give a concise overview.\n",
    "arguments" : [ {
      "name" : "owner ",
      "description" : "",
      "required" : true
    }, {
      "name" : "repo ",
      "description" : "",
      "required" : true
    } ]
  } ],
  "runtimePolicy" : {
    "logging" : true,
    "metrics" : false,
    "tracing" : false,
    "retries" : false,
    "circuitBreaker" : false
  },
  "upstream" : {
    "baseUrl" : "https://api.github.com"
  }
}
